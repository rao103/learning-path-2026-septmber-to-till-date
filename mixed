Create vpc setup:
# privider 

provider "aws" {
  region = "us-east-2"
}

# Create VPC
resource "aws_vpc" "venkat-vpc" {
  cidr_block = "10.0.0.0/16"
  tags = {
    Name = "venkat-vpc"
  }
}

# Create Public Subnet
resource "aws_subnet" "venkat-sub1-pub" {
  vpc_id                  = aws_vpc.venkat-vpc.id
  cidr_block              = "10.0.1.0/24"
  map_public_ip_on_launch = true
  tags = {
    Name = "venkat-sub1-pub"
  }
}

# Create Private Subnet
resource "aws_subnet" "venkat-sub2-private" {
  vpc_id     = aws_vpc.venkat-vpc.id
  cidr_block = "10.0.2.0/24"
  tags = {
    Name = "venkat-sub2-private"
  }
}

# Create Internet Gateway and attach to VPC
resource "aws_internet_gateway" "venkat-igw" {
  vpc_id = aws_vpc.venkat-vpc.id
  tags = {
    Name = "venkat-igw"
  }
}

# Create Public Route Table and add IGW route
resource "aws_route_table" "venkat-route1" {
  vpc_id = aws_vpc.venkat-vpc.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.venkat-igw.id
  }

  tags = {
    Name = "venkat-route1"
  }
}

# Associate Public Subnet with Public Route Table
resource "aws_route_table_association" "venkat1" {
  subnet_id      = aws_subnet.venkat-sub1-pub.id
  route_table_id = aws_route_table.venkat-route1.id
}

# Create Private Route Table (NAT route added later)
resource "aws_route_table" "venkat-route2" {
  vpc_id = aws_vpc.venkat-vpc.id
  tags = {
    Name = "venkat-route2"
  }
}

# Associate Private Subnet with Private Route Table
resource "aws_route_table_association" "venkat2" {
  subnet_id      = aws_subnet.venkat-sub2-private.id
  route_table_id = aws_route_table.venkat-route2.id
}

# Elastic IP for NAT Gateway
resource "aws_eip" "venkat-eip" {
  depends_on = [aws_internet_gateway.venkat-igw]
}

# NAT Gateway in the Public Subnet
resource "aws_nat_gateway" "venkat-NAT" {
  allocation_id = aws_eip.venkat-eip.id
  subnet_id     = aws_subnet.venkat-sub1-pub.id

  tags = {
    Name = "venkat-nat"
  }

  depends_on = [aws_eip.venkat-eip]
}

# Add NAT Route to Private Route Table
resource "aws_route" "venkat-nat-route" {
  route_table_id         = aws_route_table.venkat-route2.id
  destination_cidr_block = "0.0.0.0/0"
  nat_gateway_id         = aws_nat_gateway.venkat-NAT.id
}

# Create Security Group for SSH, HTTP, HTTPS
resource "aws_security_group" "venkat-sg" {
  name        = "venkat-sg"
  description = "Allow SSH, HTTP, HTTPS"
  vpc_id      = aws_vpc.venkat-vpc.id

  ingress {
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = {
    Name = "venkat-sg"
  }
}

